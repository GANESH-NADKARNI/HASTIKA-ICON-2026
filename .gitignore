# ===== src/: track only the scripts the Task A pipeline needs =====
# Run: python check_required.py src train multi_ensemble score_against_gold
# Add a "!src/<name>.py" line for every file it lists under NEEDED.
src/*.py
!src/utils.py
!src/train.py
!src/multi_ensemble.py
!src/score_against_gold.py

